{
  "name": "iumrah-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check src/router.js && node --test tests/*.test.mjs",
    "render": "node scripts/render-config.mjs",
    "preflight": "node scripts/preflight.mjs",
    "discover": "node scripts/discover-bindings.mjs",
    "deploy": "wrangler deploy --config wrangler.generated.jsonc",
    "dry-run": "wrangler deploy --dry-run --config wrangler.generated.jsonc"
  },
  "dependencies": {"@cloudflare/puppeteer":"1.1.0"},
  "devDependencies": {"wrangler":"^4.107.0"}
}
