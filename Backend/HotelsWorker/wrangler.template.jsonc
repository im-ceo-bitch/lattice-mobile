{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iumrah-hotels-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "iumrah.app/api/admin/ziyarats*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/api/catalog/ziyarats*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/api/admin/hotels*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/api/catalog/hotels*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/flights-feed/*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/.well-known/oauth-protected-resource*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/.well-known/oauth-authorization-server*",
      "zone_id": "__ZONE_ID__"
    }
  ],
  "d1_databases": [
    {
      "binding": "HOTELS_DB",
      "database_name": "iumrah-hotels",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    },
    {
      "binding": "BOOKINGS_DB",
      "database_name": "__BOOKING_D1_DATABASE_NAME__",
      "database_id": "__BOOKING_D1_DATABASE_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HOTELS_MEDIA",
      "bucket_name": "iumrah-hotels-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "iumrah-hotel-import",
      "binding": "HOTEL_IMPORT_WORKFLOW",
      "class_name": "HotelImportWorkflow"
    }
  ],
  "vars": {
    "APPLE_TEAM_ID": "HVT4U96286",
    "IGNAV_MONTHLY_REQUEST_BUDGET": "6000",
    "AUTH_SESSION_URL": "https://iumrah.app/api/auth/staff/session",
    "BOOKINGS_ADMIN_URL": "https://iumrah.app/api/admin/bookings",
    "BOOKINGS_PUBLIC_URL": "https://iumrah.app/api/bookings"
  },
  "images": {
    "binding": "IMAGES"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
